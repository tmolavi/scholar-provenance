{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tmolavi/scholar-provenance/schemas/paper-config.schema.json",
  "title": "PaperConfigSchema",
  "description": "Validation schema for manuscript section layouts, venue constraints, and rendering rules.",
  "type": "object",
  "required": ["structure_type", "sections", "anonymized", "target_formats"],
  "properties": {
    "structure_type": {
      "type": "string",
      "enum": [
        "empirical_imrad",
        "system_architecture",
        "benchmark_evaluation",
        "case_study",
        "systematic_review",
        "technical_report"
      ]
    },
    "anonymized": {
      "type": "boolean",
      "default": false
    },
    "word_count_target": {
      "type": "object",
      "properties": {
        "min": { "type": "integer" },
        "max": { "type": "integer" }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "heading", "required"],
        "properties": {
          "section_id": { "type": "string" },
          "heading": { "type": "string" },
          "required": { "type": "boolean" },
          "min_citations": { "type": "integer", "default": 0 },
          "subsections": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "target_formats": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["markdown", "latex", "pdf", "docx", "html", "bibtex"]
      }
    }
  }
}
